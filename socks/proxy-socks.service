[Unit]
Description=Personal authenticated Telegram SOCKS5 proxy
After=network-online.target proxy-socks-mss.service
Wants=network-online.target
Requires=proxy-socks-mss.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
ExecStartPre=/usr/sbin/danted -V -f /etc/proxy_tg/socks.conf
RuntimeDirectory=proxy-socks
RuntimeDirectoryMode=0750
ExecStart=/usr/sbin/danted -p /run/proxy-socks/danted.pid -f /etc/proxy_tg/socks.conf
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
MemoryMax=128M
CPUQuota=25%
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
