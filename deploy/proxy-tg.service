[Unit]
Description=Personal Telegram MTProto proxy
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=proxy-tg
Group=proxy-tg
EnvironmentFile=/etc/proxy_tg/proxy.env
WorkingDirectory=/var/lib/proxy_tg
ExecStart=/usr/bin/python3 /opt/proxy_tg/current/proxy.py run
Restart=on-failure
RestartSec=10
StateDirectory=proxy_tg
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryHigh=96M
MemoryMax=128M
CPUQuota=50%
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
